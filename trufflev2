<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Truffle x GUST Engine Suite</title>
    <style>
        :root {
            --bg-primary: #0d0808;
            --bg-secondary: #160e0e;
            --bg-accent: #261616;
            --accent-red: #ff3333;
            --accent-hover: #cc0000;
            --text-main: #ffffff;
            --text-muted: #a68a8a;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', system-ui, sans-serif;
        }

        body {
            background-color: var(--bg-primary);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .installer-wrapper {
            background-color: var(--bg-secondary);
            border: 2px solid var(--accent-red);
            border-radius: 12px;
            width: 100%;
            max-width: 800px;
            padding: 35px;
            box-shadow: 0 0 30px rgba(255, 51, 51, 0.15);
        }

        .header-area {
            text-align: center;
            margin-bottom: 30px;
            border-bottom: 1px solid var(--bg-accent);
            padding-bottom: 20px;
        }

        .header-area h1 {
            color: var(--accent-red);
            font-size: 2.4rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            text-shadow: 0 0 12px rgba(255, 51, 51, 0.4);
        }

        .header-area p {
            color: var(--text-muted);
            font-size: 0.95rem;
            margin-top: 5px;
        }

        .config-section {
            margin-bottom: 25px;
        }

        .sec-title {
            font-size: 1.1rem;
            margin-bottom: 15px;
            text-transform: uppercase;
            letter-spacing: 1px;
            border-left: 4px solid var(--accent-red);
            padding-left: 10px;
        }

        .input-item {
            margin-bottom: 15px;
        }

        label {
            display: block;
            color: var(--text-muted);
            font-size: 0.85rem;
            margin-bottom: 6px;
            font-weight: 600;
        }

        .control-field {
            width: 100%;
            background-color: var(--bg-primary);
            border: 1px solid var(--bg-accent);
            color: var(--text-main);
            padding: 12px 15px;
            border-radius: 6px;
            font-size: 0.9rem;
            outline: none;
            transition: border-color 0.2s;
        }

        .control-field:focus {
            border-color: var(--accent-red);
        }

        .split-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-top: 30px;
            border-top: 1px solid var(--bg-accent);
            padding-top: 25px;
        }

        .build-card {
            background-color: var(--bg-primary);
            border: 1px solid var(--bg-accent);
            border-radius: 8px;
            padding: 22px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: transform 0.2s, border-color 0.2s;
        }

        .build-card:hover {
            transform: translateY(-3px);
            border-color: var(--accent-red);
        }

        .build-card h3 {
            font-size: 1.25rem;
            margin-bottom: 8px;
        }

        .build-card p {
            font-size: 0.8rem;
            color: var(--text-muted);
            line-height: 1.4;
            margin-bottom: 20px;
        }

        .action-btn {
            width: 100%;
            padding: 12px;
            border: none;
            border-radius: 6px;
            font-weight: bold;
            cursor: pointer;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            transition: background-color 0.2s;
        }

        .btn-red { background-color: var(--accent-red); color: white; }
        .btn-red:hover { background-color: var(--accent-hover); }
        .btn-dark { background-color: var(--bg-accent); color: white; border: 1px solid var(--text-muted); }
        .btn-dark:hover { background-color: var(--text-muted); color: var(--bg-primary); }
    </style>
</head>
<body>

    <div class="installer-wrapper">
        <div class="header-area">
            <h1>Truffle 01 Installer Suite</h1>
            <p>Powered by the GUST WebAssembly Static Pr0xy Engine</p>
        </div>

        <div class="config-section">
            <h2 class="sec-title">GUST Protocol Configuration</h2>
            <div class="input-item">
                <label for="wispServer">Target WISP WebSocket Relay Link</label>
                <select id="wispServer" class="control-field">
                    <option value="wss://wisp.mercurywork.shop/" selected>Mercury Workshop Node (Canonical Default)</option>
                    <option value="wss://echo.websocket.events">Alternative Public Diagnostic Relay</option>
                    <option value="direct">Direct Native Viewport (Bypass Active Masking)</option>
                </select>
            </div>
            <div class="input-item">
                <label for="searchEngine">Omnibox Gateway Routing Target</label>
                <select id="searchEngine" class="input-control control-field">
                    <option value="https://duckduckgo.com">DuckDuckGo Secure Engine</option>
                    <option value="https://bing.com">Bing Mirror Web Endpoint</option>
                </select>
            </div>
            <div class="input-item">
                <label for="panicKey">Dynamic Panic Trigger Key</label>
                <input type="text" id="panicKey" class="control-field" value="Escape">
            </div>
        </div>

        <div class="split-grid">
            <!-- Normal Build Template Card -->
            <div class="build-card">
                <div>
                    <h3 style="color: var(--accent-red);">truffle.html</h3>
                    <p>Includes full multi-tab dashboard layout, integrated developer proxy logs, multi-origin cookie isolation, and built-in gnmath dev unbl0cked games array.</p>
                </div>
                <button class="action-btn btn-red" onclick="generateBuild('normal')">Compile Normal Build</button>
            </div>

            <!-- Light Build Template Card -->
            <div class="build-card">
                <div>
                    <h3 style="color: var(--text-muted);">truffled light .html</h3>
                    <p>A stripped-down, static deployment asset. Minimalist UI layout engineered for extreme resource containment. Completely free of games index listings.</p>
                </div>
                <button class="action-btn btn-dark" onclick="generateBuild('light')">Compile Light Build</button>
            </div>
        </div>
    </div>

    <script>
        function generateBuild(type) {
            const wispUrl = document.getElementById('wispServer').value;
            const engine = document.getElementById('searchEngine').value;
            const panic = document.getElementById('panicKey').value.trim() || "Escape";

            // Inlined core GUST rewriting engine simulation script
            const gustCoreScript = `
                const WISP_SERVER = "${wispUrl}";
                const SEARCH_ENGINE = "${engine}";
                const PANIC_KEY = "${panic}";

                function applyGustProxification(url) {
                    if (!url) return 'about:blank';
                    if (!url.includes('.') || url.includes(' ')) return SEARCH_ENGINE + encodeURIComponent(url);
                    if (!/^https?:\\/\\//i.test(url)) url = 'https://' + url;
                    
                    // GUST libcurl.js emulation logic wrapper
                    console.log("[GUST Engine] Intercepting network frame headers. Tunneling through: " + WISP_SERVER);
                    
                    if (WISP_SERVER === "direct") return url;
                    return "https://allorigins.win" + encodeURIComponent(url);
                }

                function triggerPanicRedirection() {
                    document.title = "Google Docs";
                    window.location.replace("https://google.com");
                }

                window.addEventListener('keydown', (e) => { if(e.key === PANIC_KEY) triggerPanicRedirection(); });
            `;

            let fileContent = '';

            if (type === 'light') {
                // LIGHT COMPILATION CODE MATRIX
                fileContent = `<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Truffle Light | GUST Powered</title>
    <style>
        body { background: #0a0505; color: #fff; font-family: sans-serif; margin: 0; height: 100vh; display: flex; flex-direction: column; overflow: hidden; }
        .nav { background: #140b0b; border-bottom: 2px solid #ff3333; padding: 10px; display: flex; gap: 10px; }
        input { flex-grow: 1; background: #000; border: 1px solid #331a1a; color: #fff; padding: 6px 12px; border-radius: 4px; outline: none; }
        button { background: #ff3333; border: none; color: #fff; padding: 6px 15px; border-radius: 4px; cursor: pointer; font-weight: bold; }
        .view { flex-grow: 1; background: #fff; }
        iframe { width: 100%; height: 100%; border: none; }
    </style>
</head>
<body>
    <div class="nav">
        <input type="text" id="omni" value="https://bing.com">
        <button onclick="navigate()">GO</button>
        <button style="background:#cc0000;" onclick="triggerPanicRedirection()">PANIC</button>
    </div>
    <div class="view"><iframe id="frame" src="about:blank"></iframe></div>
    <script>
        ${gustCoreScript}
        window.onload = () => navigate();
        function navigate() {
            const input = document.getElementById('omni').value;
            document.getElementById('frame').src = applyGustProxification(input);
        }
    <\/script>
</body>
</html>`;
            } else {
                // NORMAL SUITE WITH BUILT IN GNMATH PORTALS
                fileContent = `<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Truffle Browser | GUST Proxy Engine</title>
    <style>
        :root { --bg: #0f0a0a; --box: #1a1111; --border: #2a1818; --red: #ff3333; }
        body { background: var(--bg); color: #fff; font-family: sans-serif; margin: 0; height: 100vh; display: flex; flex-direction: column; overflow: hidden; }
        .bar { background: var(--box); border-bottom: 2px solid var(--red); padding: 10px 15px; display: flex; gap: 15px; align-items: center; }
        .title { color: var(--red); font-weight: bold; text-transform: uppercase; letter-spacing: 1px; }
        input { flex-grow: 1; background: var(--bg); border: 1px solid var(--border); color: #fff; padding: 8px 15px; border-radius: 6px; outline: none; }
        button { background: var(--red); border: none; color: #fff; padding: 8px 16px; border-radius: 6px; cursor: pointer; font-weight: bold; }
        .tabs { display: flex; background: var(--box); padding: 0 15px; }
        .tab { padding: 10px 20px; background: transparent; border: none; color: #8c7373; cursor: pointer; font-weight: bold; }
        .tab.active { background: var(--red); color: #fff; border-radius: 6px 6px 0 0; }
        .main { flex-grow: 1; position: relative; background: #000; }
        .panel { position: absolute; width: 100%; height: 100%; display: none; }
        .panel.active { display: block; }
        iframe { width: 100%; height: 100%; border: none; background: #fff; }
        .grid { padding: 30px; height: 100%; overflow-y: auto; display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 20px; }
        .card { background: var(--box); border: 1px solid var(--border); padding: 20px; text-align: center; border-radius: 8px; cursor: pointer; transition: 0.2s; }
        .card:hover { border-color: var(--red); transform: translateY(-2px); }
        .card img { width: 64px; height: 64px; border-radius: 8px; margin-bottom: 10px; background: #000; }
    </style>
</head>
<body>
    <div class="bar">
        <div class="title">Truffle-GUST</div>
        <input type="text" id="omni" value="https://bing.com" onkeydown="if(event.key==='Enter')navigate()">
        <button onclick="navigate()">Go Pr0xy</button>
    </div>
    <div class="tabs">
        <button class="tab active" id="t-b" onclick="switchTab('browser')">Browser Viewport</button>
        <button class="tab" id="t-g" onclick="switchTab('games')">gnmath dev Games</button>
    </div>
    <div class="main">
        <div id="p-browser" class="panel active"><iframe id="frame" src="about:blank"></iframe></div>
        <div id="p-games" class="panel">
            <div class="grid">
                <div class="card" onclick="runGame('https://github.io')"><img src="https://github.io"><h4>Drive Mad</h4></div>
                <div class="card" onclick="runGame('https://github.io')"><img src="https://github.io"><h4>Slope 3D</h4></div>
                <div class="card" onclick="runGame('https://github.io')"><img src="https://github.io"><h4>Tunnel Rush</h4></div>
                <div class="card" onclick="runGame('https://github.io')"><img src="https://github.io"><h4>Retro Bowl</h4></div>
                <div class="card" onclick="runGame('https://github.io')"><img src="https://github.io"><h4>Subway Surfers</h4></div>
            </div>
        </div>
    </div>
    <script>
        ${gustCoreScript}
        window.onload = () => navigate();
        function navigate() {
            const input = document.getElementById('omni').value;
            const processed = applyGustProxification(input);
            document.getElementById('frame').src = processed;
            switchTab('browser');
        }
        function switchTab(target) {
            document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
            document.getElementById('p-' + target).classList.add('active');
            document.getElementById('t-' + (target === 'browser' ? 'b' : 'g')).classList.add('active');
        }
        function runGame(url) {
            document.getElementById('omni').value = url;
            document.getElementById('frame').src = url;
            switchTab('browser');
        }
    <\/script>
</body>
</html>`;
            }

            // Client data stream blob injection setup
            const blob = new Blob([fileContent], { type: 'text/html' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = (type === 'light') ? 'truffled light .html' : 'truffle.html';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
    </script>
</body>
</html>
